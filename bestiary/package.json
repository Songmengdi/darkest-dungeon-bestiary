    "ui-preview": "vite preview",
    "serve-dist": "set BESTIARY_ROOT=../dist&& node scripts/serve.ts"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
