{
  "name": "dd1-bestiary",
  "version": "1.0.0",
  "description": "暗黑地牢1 怪物图鉴 —— 独立 Web 应用,数据直接解析自本机游戏文件",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "serve": "node scripts/serve.ts",
